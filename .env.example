# Cozy Weather & Live Earth Platform Configuration
# Copy this file to `.env` and fill in your API credentials.

# OpenWeatherMap API Key (Used for weather queries & tile overlays)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# xAI Grok API Key (Used for optional AI weather assistant features)
GROK_API_KEY=your_grok_api_key_here

# Windy Webcams v3 API Key (Optional: Expands global public webcam directory)
WINDY_WEBCAMS_API_KEY=your_windy_webcams_api_key_here
